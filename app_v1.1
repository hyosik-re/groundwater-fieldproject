def compose_static_map(base_bytes, bounds, overlay_bytes=None, opacity=.78,
                       center=None, markers=None, size=(1400, 600)):
    """지도 이미지를 서버에서 직접 합성해 iframe/Leaflet 없이 표시."""
    try:
        if base_bytes:
            canvas = Image.open(BytesIO(base_bytes)).convert("RGBA").resize(size)
        else:
            canvas = Image.new("RGBA", size, "#eef2f1")
        if overlay_bytes:
            overlay = Image.open(BytesIO(overlay_bytes)).convert("RGBA").resize(size)
            alpha = overlay.getchannel("A").point(lambda a: int(a * opacity))
            overlay.putalpha(alpha)
            canvas = Image.alpha_composite(canvas, overlay)

        draw = ImageDraw.Draw(canvas)
        south, west = bounds[0]
        north, east = bounds[1]
        def xy(point):
            py, px = point
            x = int((px-west) / (east-west) * size[0])
            y = int((north-py) / (north-south) * size[1])
            return x, y

        if markers:
            for idx, marker in enumerate(markers, 1):
                x, y = xy(marker)
                draw.ellipse((x-10,y-10,x+10,y+10), fill="#087f89", outline="white", width=3)
                label = str(idx)
                draw.text((x-3 if idx < 10 else x-6, y-7), label, fill="white")
        if center:
            x, y = xy(center)
            draw.ellipse((x-9,y-9,x+9,y+9), fill="#e14b42", outline="white", width=4)

        output = BytesIO()
        canvas.convert("RGB").save(output, format="JPEG", quality=91, optimize=True)
        return output.getvalue()
    except Exception:
        return None

@st.cache_data(ttl=3600)
def get_real_wells_osm(lat, lon, radius=10000):
    """OSM에 실제 등록된 우물/지하수 관측시설의 이름과 좌표만 조회."""
    query = f'''[out:json][timeout:35];(
      node["man_made"="water_well"](around:{radius},{lat},{lon});
      way["man_made"="water_well"](around:{radius},{lat},{lon});
      relation["man_made"="water_well"](around:{radius},{lat},{lon});
      node["man_made"="monitoring_station"]["monitoring:groundwater"](around:{radius},{lat},{lon});
      way["man_made"="monitoring_station"]["monitoring:groundwater"](around:{radius},{lat},{lon});
    );out center tags;'''
    endpoints = [
        "https://overpass-api.de/api/interpreter",
        "https://overpass.kumi.systems/api/interpreter",
    ]
    data = None
    for endpoint in endpoints:
        try:
            r = requests.get(endpoint, params={"data":query},
                headers={"User-Agent":"KISTI-groundwater-dashboard/1.0"}, timeout=55)
            if r.status_code == 200:
                data = r.json()
                break
        except Exception:
            continue
    if not data:
        return None
    wells = []
    for e in data.get("elements", []):
        tags = e.get("tags", {})
        center = e.get("center", {})
        wy, wx = e.get("lat", center.get("lat")), e.get("lon", center.get("lon"))
        if wy is None or wx is None:
            continue
        name = tags.get("name") or tags.get("name:ko") or tags.get("ref") or "이름 미등록"
        wells.append({"관정명":name, "위도":round(wy, 6), "경도":round(wx, 6), "OSM ID":f"{e['type']}/{e['id']}"})
    return pd.DataFrame(wells).drop_duplicates(subset=["위도","경도"]) if wells else pd.DataFrame(columns=["관정명","위도","경도","OSM ID"])

@st.cache_data(ttl=21600, show_spinner=False)
def get_gims_wells(lat, lon, radius_km=5, max_features=5000):
    """국가지하수정보센터(GIMS) 공개 WFS에서 주변 개발이용관정을 조회."""
    lat_delta = radius_km / 111.0
    lon_delta = radius_km / (111.0 * max(math.cos(math.radians(lat)), .35))
    cql = (
        f"BBOX(the_geom,{lon-lon_delta},{lat-lat_delta},"
        f"{lon+lon_delta},{lat+lat_delta},'EPSG:4326')"
    )
    params = {
        "service":"WFS", "version":"1.1.0", "request":"GetFeature",
        "typeName":"igis_WFS:WT_PERMWELL_WGS",
        "outputFormat":"application/json", "srsName":"EPSG:4326",
        "maxFeatures":max_features, "CQL_FILTER":cql,
    }
    try:
        response = requests.get(
            "https://new.gims.go.kr/igis/gis-server/wfs",
            params=params,
            headers={
                "User-Agent":"KISTI-groundwater-dashboard/2.0",
                "Referer":"https://new.gims.go.kr/igis",
            },
            timeout=60,
        )
        response.raise_for_status()
        payload = response.json()
    except Exception:
        return None, None

    rows = []
    type_names = {"1":"허가공", "2":"신고공", "0":"기타공"}
    for feature in payload.get("features", []):
        geometry = feature.get("geometry") or {}
        coordinates = geometry.get("coordinates") or []
        if geometry.get("type") != "Point" or len(coordinates) < 2:
            continue
        well_lon, well_lat = float(coordinates[0]), float(coordinates[1])
        props = feature.get("properties") or {}
        lat1, lat2 = math.radians(lat), math.radians(well_lat)
        dlat = lat2 - lat1
        dlon = math.radians(well_lon - lon)
        hav = math.sin(dlat/2)**2 + math.cos(lat1)*math.cos(lat2)*math.sin(dlon/2)**2
        distance = 6371.0088 * 2 * math.asin(min(1, math.sqrt(hav)))
        if distance > radius_km:
            continue
        lot = ""
        if props.get("BUNJI"):
            lot = f"{'산 ' if str(props.get('SAN', '0')) == '1' else ''}{props['BUNJI']}"
            if props.get("HO") and str(props["HO"]) not in ("0", "None"):
                lot += f"-{props['HO']}"
        address_parts = [
            props.get("BRTC_NM"), props.get("SIGUN_NM"), props.get("EMD_NM"),
            props.get("LI_NM"), lot,
        ]
        rows.append({
            "관정번호":props.get("PERM_NT_NO") or props.get("objectid"),
            "구분":type_names.get(str(props.get("PERM_NT_FO")), "기타공"),
            "주소":" ".join(str(v).strip() for v in address_parts if v),
            "용도":props.get("UWATER_SRV") or "-",
            "굴착심도(m)":props.get("DPH"),
            "양수능력(㎥/일)":props.get("RWT_CAP"),
            "거리(km)":round(distance, 3),
            "위도":round(well_lat, 7), "경도":round(well_lon, 7),
        })
    columns = ["관정번호","구분","주소","용도","굴착심도(m)","양수능력(㎥/일)","거리(km)","위도","경도"]
    frame = pd.DataFrame(rows, columns=columns)
    if not frame.empty:
        frame = frame.sort_values("거리(km)").drop_duplicates("관정번호").reset_index(drop=True)
    total = payload.get("totalFeatures")
    meta = {
        "total_bbox":int(total) if str(total).isdigit() else len(payload.get("features", [])),
        "returned":len(payload.get("features", [])),
        "truncated":len(payload.get("features", [])) >= max_features,
    }
    return frame, meta

def geology_color(value):
    palette = ["#547b72","#a56f59","#c49a55","#7d6b91","#6686a3","#8b9d62","#b67878","#4e8d8a"]
    return palette[int(hashlib.md5(str(value).encode()).hexdigest(), 16) % len(palette)]

def landcover_legend_html():
    groups = []
    for group_name, items in LANDCOVER_GROUPS.items():
        rows = []
        for code, name, rgb in items:
            color = f"rgb({rgb[0]},{rgb[1]},{rgb[2]})"
            rows.append(
                f'<div class="lc-item"><span class="lc-swatch" style="background:{color}"></span>'
                f'<span>{name}<span class="lc-code">{code}</span></span></div>'
            )
        groups.append(
            f'<div class="lc-group"><div class="lc-group-title">{group_name}</div>'
            f'<div class="lc-items">{"".join(rows)}</div></div>'
        )
    return f'<div class="lc-legend">{"".join(groups)}</div>'

@st.cache_data(ttl=86400, show_spinner=False)
def get_osmnx_layers(lat, lon, distance=1500):
    """OSMnx로 도로망과 주변 공간객체를 GeoDataFrame으로 조회."""
    empty = gpd.GeoDataFrame(geometry=[], crs="EPSG:4326")
    edges, features = empty.copy(), empty.copy()
    try:
        graph = ox.graph_from_point(
            (lat, lon), dist=distance, network_type="all", simplify=True
        )
        _, edges = ox.graph_to_gdfs(graph)
    except Exception:
        pass
    try:
        features = ox.features_from_point(
            (lat, lon),
            tags={
                "building": True,
                "landuse": True,
                "natural": ["wood", "water", "grassland"],
                "leisure": ["park", "garden"],
            },
            dist=distance,
        )
    except Exception:
        pass
    return edges, features

def _landuse_value(row):
    for key in ("landuse", "natural", "leisure"):
        value = row.get(key)
        if pd.notna(value):
            return str(value)
    return "other"

def _landuse_color(value):
    colors = {
        "residential":"#e8d8c8", "commercial":"#e9b7b1", "retail":"#efc2d7",
        "industrial":"#d8c8df", "farmland":"#e8e3a5", "farm":"#e8e3a5",
        "forest":"#9fc89d", "wood":"#8eb68b", "grass":"#c8dda9",
        "grassland":"#c8dda9", "meadow":"#c8dda9", "park":"#b7d7ad",
        "garden":"#c7dfb8", "water":"#9ecae1", "reservoir":"#9ecae1",
        "basin":"#9ecae1", "construction":"#d8c1ac",
    }
    return colors.get(value, "#d9dfdc")

def plot_osmnx_geopandas_map(lat, lon, distance=1500, mode="streets"):
    """OSMnx 수집 결과를 GeoPandas 레이어로 투영해 정적 지도 생성."""
    edges, features = get_osmnx_layers(lat, lon, distance)
    if edges.empty and features.empty:
        return None
    crs_source = edges if not edges.empty else features
    local_crs = crs_source.estimate_utm_crs()
    center = gpd.GeoDataFrame(
        {"name":["검색 위치"]}, geometry=[Point(lon, lat)], crs="EPSG:4326"
    ).to_crs(local_crs)
    x, y = center.geometry.iloc[0].x, center.geometry.iloc[0].y

    fig, ax = plt.subplots(figsize=(14, 6.2), facecolor="#f7f7f7")
    ax.set_facecolor("#ffffff")
    if not features.empty:
        local_features = features.to_crs(local_crs).copy()
        polygons = local_features[local_features.geom_type.isin(["Polygon", "MultiPolygon"])].copy()
        if not polygons.empty:
            polygons["map_type"] = polygons.apply(_landuse_value, axis=1)
            if mode == "landuse":
                polygons.plot(
                    ax=ax,
                    color=[_landuse_color(v) for v in polygons["map_type"]],
                    edgecolor="#ffffff", linewidth=.45, alpha=.88, zorder=1,
                )
            else:
                non_building = polygons[polygons.get("building", pd.Series(index=polygons.index, dtype=object)).isna()]
                buildings = polygons[polygons.get("building", pd.Series(index=polygons.index, dtype=object)).notna()]
                if not non_building.empty:
                    non_building.plot(ax=ax, color="#d8e4d4", edgecolor="none", alpha=.7, zorder=1)
                if not buildings.empty:
                    buildings.plot(ax=ax, color="#c8cecc", edgecolor="#aab4b1", linewidth=.25, zorder=2)
    if not edges.empty:
        local_edges = edges.to_crs(local_crs).copy()
        widths = {"motorway":2.1, "trunk":1.9, "primary":1.7, "secondary":1.35,
                  "tertiary":1.05, "residential":.72, "service":.45, "footway":.3}
        highway = local_edges.get("highway", pd.Series("road", index=local_edges.index))
        local_edges["line_width"] = highway.apply(
            lambda v: widths.get(v[0] if isinstance(v, list) and v else v, .55)
        )
        local_edges.plot(
            ax=ax, color="#ffffff" if mode == "landuse" else "#65777a",
            linewidth=local_edges["line_width"], alpha=.95, zorder=3,
        )
    center.plot(ax=ax, color="#e14b42", edgecolor="white", linewidth=1.8, markersize=105, zorder=5)
    ax.set_xlim(x-distance, x+distance)
    ax.set_ylim(y-distance*.62, y+distance*.62)
    ax.set_aspect("equal")
    ax.axis("off")
    title = "OSM 토지이용 · 도로망" if mode == "landuse" else "OSM 도로 · 건물 · 녹지"
    ax.set_title(title, loc="left", fontsize=15, fontweight="bold", color="#4a4a4a", pad=12)
    fig.tight_layout()
    return fig

def plot_weather_netgraph(df, days=90):
    """날짜를 연결한 NetGraph: 색=평균기온, 크기=강수량."""
    weather = df.tail(days).dropna(subset=["평균기온(℃)"]).copy()
    if weather.empty:
        return None
    count = len(weather)
    nodes = list(range(count))
    edges = [(i, i + 1) for i in range(count - 1)]
    temperatures = weather["평균기온(℃)"].astype(float).to_numpy()
    rainfall = weather["강수량(mm)"].fillna(0).clip(lower=0).astype(float).to_numpy()
    t_min, t_max = float(np.nanmin(temperatures)), float(np.nanmax(temperatures))
    t_range = max(t_max - t_min, 1.0)
    t_norm = (temperatures - t_min) / t_range
    rain_scale = np.sqrt(rainfall / max(float(np.nanmax(rainfall)), 1.0))
    positions = {
        node:(.04 + .92 * node / max(count - 1, 1), .12 + .76 * t_norm[node])
        for node in nodes
    }
    cmap = mpl.colormaps["coolwarm"]
    node_colors = {node:cmap(t_norm[node]) for node in nodes}
    # 90개 노드가 촘촘하므로 반지름을 작게 유지해 인접 노드/간선 겹침을 방지한다.
    node_sizes = {node:.2 + .2 * rain_scale[node] for node in nodes}
    label_step = max(1, count // 8)
    labels = {
        node:weather.index[node].strftime("%m/%d")
        for node in nodes if node % label_step == 0 or node == count - 1
    }
    fig, ax = plt.subplots(figsize=(14, 6.2), facecolor="#f7f7f7")
    ax.set_facecolor("#ffffff")
    Graph(
        edges, nodes=nodes, node_layout=positions, node_color=node_colors,
        node_size=node_sizes, node_edge_color="white", node_edge_width=.02,
        edge_color="#999999", edge_width=1.15, edge_alpha=.55,
        node_labels=False, ax=ax,
    )
    for node, label in labels.items():
        px, py = positions[node]
        ax.text(px, py-.045, label, ha="center", va="top", fontsize=8, color="#555555")
    scalar = mpl.cm.ScalarMappable(norm=mpl.colors.Normalize(t_min, t_max), cmap=cmap)
    cbar = fig.colorbar(scalar, ax=ax, fraction=.025, pad=.02)
    cbar.set_label("평균기온 (℃)")
    ax.set_title("날짜 연결망으로 본 기온과 강수", loc="left", fontsize=15,
                 fontweight="bold", color="#4a4a4a", pad=12)
    fig.tight_layout()
    return fig

