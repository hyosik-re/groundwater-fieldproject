                a2.metric("초미세먼지(PM2.5)", f"{pm25} µg/m³", delta="좋음" if pm25<=15 else ("보통" if pm25<=35 else "나쁨"), delta_color="off" if pm25<=35 else "inverse")
            st.markdown("---")
            with st.spinner("최근 1년 기상 데이터 조회 중..."):
                hist = get_real_weather(lat, lon)
            if hist and "daily" in hist:
                d = hist["daily"]
                times = d.get("time", []) or []
                row_count = len(times)
                def aligned(key):
                    values = list(d.get(key, []) or [])
                    return (values + [None] * row_count)[:row_count]
                codes = aligned("weather_code")
                df = pd.DataFrame({
                    "날짜": pd.to_datetime(times),
                    "날씨": [" ".join(WEATHER_CODES.get(c,("❓","알 수 없음"))) if c is not None else "-" for c in codes],
                    "평균기온(℃)": aligned("temperature_2m_mean"),
                    "최고기온(℃)": aligned("temperature_2m_max"),
                    "최저기온(℃)": aligned("temperature_2m_min"),
                    "강수량(mm)": aligned("precipitation_sum"),
                }).set_index("날짜")
                numeric_cols = ["평균기온(℃)","최고기온(℃)","최저기온(℃)","강수량(mm)"]
                for col in numeric_cols:
                    df[col] = pd.to_numeric(df[col], errors="coerce")
                if not df.empty:
                    st.subheader(f"🌡️ NetGraph 기상 연결망 ({min(len(df), 90)}일)")
                    weather_fig = plot_weather_netgraph(df, days=90)
                    if weather_fig:
                        st.pyplot(weather_fig, width="stretch")
                        plt.close(weather_fig)
                        st.caption("각 노드는 하루입니다. 왼쪽→오른쪽은 날짜 순서, 높이·색은 평균기온, 노드 크기는 강수량을 나타냅니다.")
                    else:
                        st.warning("NetGraph를 그릴 수 있는 기온 값이 없습니다.")
                    with st.expander("📅 상세 데이터 표", expanded=True):
                        period = st.selectbox("표시 기간", [7, 30, 90], index=1,
                            format_func=lambda x:f"최근 {x}일", key="weather_table_period")
                        display_df = df.reset_index().tail(period).sort_values("날짜", ascending=False)
                        display_df["날짜"] = display_df["날짜"].dt.strftime("%Y-%m-%d")
                        display_df[numeric_cols] = display_df[numeric_cols].round(1)
                        display_df = display_df.fillna("-")
                        table_html = display_df.to_html(index=False, border=0, classes="weather-table", escape=True)
                        st.markdown(f'<div class="weather-table-wrap">{table_html}</div>', unsafe_allow_html=True)
                        csv_data = df.reset_index().to_csv(index=False).encode("utf-8-sig")
                        st.download_button("전체 기상 데이터 CSV 다운로드", csv_data,
                            file_name="weather_daily.csv", mime="text/csv")
                else:
                    st.warning("일별 기상 값이 비어 있습니다. 잠시 후 다시 조회해 주세요.")
            else:
                st.error("기상 데이터를 가져오지 못했습니다. 잠시 후 다시 시도해주세요.")

        with tabs[5]:
            st.header("주변 관정")
            st.markdown('<div class="source-note">국가지하수정보센터(GIMS)의 공개 WFS에서 실제 개발이용관정(허가공·신고공·기타공)을 조회합니다.</div>', unsafe_allow_html=True)
            radius_km = st.select_slider(
                "조회 반경", options=[1, 2, 5, 10], value=5,
                format_func=lambda x:f"{x} km", key="gims_radius"
            )
            with st.spinner("GIMS 등록 관정을 조회하는 중..."):
                df_w, gims_meta = get_gims_wells(lat, lon, radius_km)
            if df_w is not None and not df_w.empty:
                df_w = df_w.copy()
                df_w.insert(0, "번호", range(1, len(df_w)+1))
                permit_count = int((df_w["구분"] == "허가공").sum())
                report_count = int((df_w["구분"] == "신고공").sum())
                c1, c2, c3 = st.columns(3)
                c1.metric("반경 내 관정", f"{len(df_w):,}개")
                c2.metric("허가공", f"{permit_count:,}개")
                c3.metric("신고공", f"{report_count:,}개")

                well_map = folium.Map(location=[lat, lon], zoom_start=12, control_scale=True)
                folium.Marker(
                    [lat, lon], tooltip="검색 위치",
                    icon=folium.Icon(color="red", icon="home"),
                ).add_to(well_map)
                cluster = MarkerCluster(name="GIMS 개발이용관정").add_to(well_map)
                marker_colors = {"허가공":"blue", "신고공":"green", "기타공":"gray"}
                for _, row in df_w.head(1000).iterrows():
                    popup = (
                        f"<b>{row['구분']} · {row['관정번호']}</b><br>"
                        f"{row['주소']}<br>용도: {row['용도']}<br>"
                        f"거리: {row['거리(km)']:.3f} km"
                    )
                    folium.Marker(
                        [row["위도"], row["경도"]], popup=folium.Popup(popup, max_width=360),
                        tooltip=f"{row['구분']} · {row['거리(km)']:.2f} km",
                        icon=folium.Icon(color=marker_colors.get(row["구분"], "cadetblue"), icon="tint"),
                    ).add_to(cluster)
                folium.LayerControl().add_to(well_map)
                render_map(well_map, height=520)
                if len(df_w) > 1000:
                    st.caption("지도 성능을 위해 가까운 관정 1,000개만 표기하며, 아래 표와 CSV에는 조회 결과 전체를 제공합니다.")
                if gims_meta and gims_meta.get("truncated"):
                    st.warning("선택 영역의 관정이 5,000개를 넘어 일부만 반환됐습니다. 조회 반경을 줄이면 더 정확한 거리순 결과를 볼 수 있습니다.")
                visible_cols = ["번호","관정번호","구분","주소","용도","굴착심도(m)","양수능력(㎥/일)","거리(km)"]
                st.dataframe(df_w[visible_cols], width="stretch", hide_index=True)
                csv_data = df_w.drop(columns="번호").to_csv(index=False).encode("utf-8-sig")
                st.download_button(
                    "GIMS 관정 목록 CSV 다운로드", csv_data,
                    file_name=f"gims_wells_{radius_km}km.csv", mime="text/csv"
                )
            elif df_w is not None:
                st.info(f"GIMS에서 반경 {radius_km} km 안의 개발이용관정을 찾지 못했습니다.")
            else:
                st.warning("GIMS 관정 서비스에 연결하지 못했습니다. 잠시 후 다시 시도해 주세요.")
            st.caption("자료: 국가지하수정보센터(GIMS) 지하수정보지도 · 빨간 표식: 검색 위치")
            st.link_button("GIMS 지하수정보지도에서 확인", "https://new.gims.go.kr/igis")
    else:
        st.error("주소를 좌표로 변환할 수 없습니다.")

