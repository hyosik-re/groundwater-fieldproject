@st.cache_data(ttl=86400)
def get_land_use_osm(lat, lon, radius=1500):
    query = f'[out:json][timeout:25];(way["landuse"](around:{radius},{lat},{lon}););out body;>;out skel qt;'
    try:
        r = requests.get("https://overpass-api.de/api/interpreter", params={"data":query}, timeout=30)
        if r.status_code!=200: return None
        data = r.json()
        nodes = {e["id"]:[e["lat"],e["lon"]] for e in data.get("elements",[]) if e["type"]=="node"}
        polys = []
        for e in data.get("elements",[]):
            if e["type"]=="way":
                coords = [nodes[n] for n in e.get("nodes",[]) if n in nodes]
                if len(coords)>=3:
                    polys.append({"coords":coords,"type":e.get("tags",{}).get("landuse","unknown")})
        return polys
    except: return None

@st.cache_data(ttl=86400)
def get_geology_glim(lat, lon, span=0.08):
    """검색 지점 주변의 실제 GLiM 지질 폴리곤을 GeoJSON으로 반환."""
    url = "https://services8.arcgis.com/4KhTMTZ1x0f76DSg/arcgis/rest/services/GLiM_Niveau_I/FeatureServer/1/query"
    params = {
        "where":"1=1", "geometry":f"{lon-span},{lat-span},{lon+span},{lat+span}",
        "geometryType":"esriGeometryEnvelope", "inSR":4326,
        "spatialRel":"esriSpatialRelIntersects", "outFields":"Litho,xx,xx_Description",
        "returnGeometry":"true", "outSR":4326, "f":"geojson"
    }
    try:
        r = requests.get(url, params=params, timeout=30)
        r.raise_for_status()
        data = r.json()
        return data if data.get("features") else None
    except Exception:
        return None

def wide_bounds(lat, lon, lat_span=0.08):
    """가로형 지도 화면에 맞는 EPSG:4326 경계."""
    lon_span = lat_span * 2.35 / max(math.cos(math.radians(lat)), 0.65)
    return [[lat-lat_span, lon-lon_span], [lat+lat_span, lon+lon_span]]

@st.cache_data(ttl=86400, show_spinner=False)
def get_static_basemap(bounds):
    """브라우저 타일 차단을 피하기 위한 서버 측 정적 도로지도."""
    south, west = bounds[0]
    north, east = bounds[1]
    params = {
        "bbox":f"{west},{south},{east},{north}", "bboxSR":4326, "imageSR":4326,
        "size":"1400,600", "format":"png32", "transparent":"false", "f":"image"
    }
    try:
        r = requests.get(
            "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/export",
            params=params, timeout=40
        )
        r.raise_for_status()
        return r.content if "image" in r.headers.get("Content-Type", "") else None
    except Exception:
        return None

@st.cache_data(ttl=86400, show_spinner=False)
def get_kigam_geology_image(lat, lon, api_key, layer="L_50K_Geology_Map", lat_span=0.08):
    """KIGAM WMS 이미지를 서버에서 받아 인증키가 브라우저에 노출되지 않게 반환."""
    bounds = wide_bounds(lat, lon, lat_span)
    south, west = bounds[0]
    north, east = bounds[1]
    params = {
        "key":api_key, "SERVICE":"WMS", "VERSION":"1.1.1", "REQUEST":"GetMap",
        "LAYERS":layer, "STYLES":"", "SRS":"EPSG:4326",
        "BBOX":f"{west},{south},{east},{north}",
        "WIDTH":1400, "HEIGHT":600, "FORMAT":"image/png", "TRANSPARENT":"TRUE"
    }
    try:
        r = requests.get("https://data.kigam.re.kr/openapi/wms", params=params, timeout=40)
        r.raise_for_status()
        if "image" not in r.headers.get("Content-Type", ""):
            return None
        return r.content, bounds
    except Exception:
        return None

